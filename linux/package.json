{
  "name": "localls-fedora",
  "version": "1.41.0",
  "description": "LocalLS — Fedora SSH/SFTP client and built-in QR server",
  "author": "MSS9LN",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "bash tools/run-ui-fedora.sh",
    "build:linux-dir": "electron-builder --linux dir --x64 --publish never",
    "build:rpm": "bash tools/build-rpm.sh"
  },
  "build": {
    "appId": "com.localls.fedora",
    "productName": "LocalLS",
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.node",
      "!node_modules/cpu-features/**/*",
      "!node_modules/nan/**/*",
      "release.json",
      "!src/platform.cjs",
      "!assets/*.ico"
    ],
    "asar": true,
    "npmRebuild": false,
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png",
      "category": "Network",
      "executableName": "localls"
    },
    "publish": []
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "ssh2": "1.17.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0"
  },
  "overrides": {
    "sprintf-js": "1.1.4"
  }
}
