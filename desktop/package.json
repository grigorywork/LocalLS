{
  "name": "localls-desktop",
  "version": "1.41.0",
  "description": "LocalLS \u2014 Windows SSH/SFTP client and server",
  "author": "MSS9LN",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tools/ui-smoke.cjs",
    "build:win": "node tools/build-windows.cjs",
    "build:linux-test": "electron-builder --linux dir --x64"
  },
  "build": {
    "appId": "com.localls.desktop",
    "productName": "LocalLS",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "directories": {
      "output": "artifacts"
    },
    "files": [
      "src/**/*",
      "release.json",
      "assets/**/*",
      "package.json",
      "!**/*.node",
      "!node_modules/cpu-features/**/*",
      "!node_modules/nan/**/*",
      "!node_modules/ssh2/lib/protocol/crypto/build/**/*",
      "!node_modules/buildcheck/**/*"
    ],
    "asar": {
      "smartUnpack": false
    },
    "afterPack": "tools/after-pack.cjs",
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "LocalLS-1.41-Windows-x64-Setup.exe",
      "script": "tools/installer.nsi",
      "warningsAsErrors": false
    },
    "linux": {
      "target": "dir",
      "icon": "assets/icon.png",
      "category": "Network"
    },
    "publish": []
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "ssh2": "1.17.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "playwright": "1.64.0",
    "resedit": "3.1.0"
  },
  "overrides": {
    "sprintf-js": "1.1.4"
  }
}
