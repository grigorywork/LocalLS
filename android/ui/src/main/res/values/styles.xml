        <item name="hscTextPrimary">#F5F7FA</item><item name="hscTextSecondary">#B3BBC7</item><item name="hscStroke">#687484</item>
        <item name="hscSecondaryButton">#98252B37</item><item name="hscSuccess">#51E58A</item>
        <item name="android:windowLightStatusBar">false</item><item name="android:statusBarColor">#000000</item><item name="android:navigationBarColor">#000000</item>
        <item name="android:colorBackground">#000000</item><item name="android:textColorPrimary">#F5F7FA</item><item name="android:textColorSecondary">#B3BBC7</item>
