<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/hscBackground" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Настройка сервера" android:textColor="?attr/hscTextPrimary" android:textSize="18sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="На серверном устройстве подготовь SSH. На другом устройстве импортируй профиль. Команды вводить не нужно." android:textColor="?attr/hscTextSecondary" android:textSize="13sp" />
<Button android:id="@+id/importServerProfileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Импорт профиля" style="@style/Widget.HSC.SecondaryButton" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="1. Среда сервера" android:textColor="?attr/hscTextPrimary" android:textSize="18sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Установи официальный Termux и открой один раз для подготовки среды. Вернись сюда. Ничего печатать в нём не нужно." android:textColor="?attr/hscTextSecondary" android:textSize="13sp" />
<Button android:id="@+id/prepareTermuxButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Установить / открыть Termux" style="@style/Widget.HSC.CompactButton" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="2. Доступ к папке Termux" android:textColor="?attr/hscTextPrimary" android:textSize="18sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="В системном выборе папок открой раздел Termux и выбери его корневую папку. Остальные настройки сохранятся." android:textColor="?attr/hscTextSecondary" android:textSize="13sp" />
<Button android:id="@+id/selectTermuxFolderButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Выбрать папку Termux" style="@style/Widget.HSC.CompactButton" />
<TextView android:id="@+id/termuxFolderStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Папка не выбрана" android:textColor="?attr/hscTextSecondary" android:textSize="13sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="3. Вход и подготовка SSH" android:textColor="?attr/hscTextPrimary" android:textSize="18sp" />
<CheckBox android:id="@+id/createServerPasswordCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Задать новый пароль сервера" android:textColor="?attr/hscTextPrimary" android:saveEnabled="false" />
<EditText android:id="@+id/serverSetupPasswordInput" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Пароль сервера" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:textColor="?attr/hscTextPrimary" android:textColorHint="?attr/hscTextSecondary" />
<EditText android:id="@+id/serverSetupPasswordConfirm" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Повтори новый пароль" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:visibility="gone" android:textColor="?attr/hscTextPrimary" android:textColorHint="?attr/hscTextSecondary" />
<Button android:id="@+id/startServerSetupButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Подготовить сервер" style="@style/Widget.HSC.CompactButton" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="OpenSSH установится при отсутствии. Работающий sshd останется запущенным. Автозапуск и конфигурация sshd сохранятся. Папка файлов: Termux / LocalLS." android:textColor="?attr/hscTextSecondary" android:textSize="13sp" />
<TextView android:id="@+id/serverSetupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Сервер ещё не проверен" android:textColor="?attr/hscTextPrimary" android:textSize="18sp" />
<Button android:id="@+id/verifyServerSetupButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Проверить SSH и пароль" style="@style/Widget.HSC.CompactButton" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="4. Подключение другого устройства" android:textColor="?attr/hscTextPrimary" android:textSize="18sp" />
<EditText android:id="@+id/serverSetupHostInput" android:layout_width="match_parent" android:layout_height="48dp" android:hint="IP-адрес сервера в Wi-Fi" android:inputType="textUri" android:singleLine="true" android:saveEnabled="true" android:textColor="?attr/hscTextPrimary" android:textColorHint="?attr/hscTextSecondary" />
<Button android:id="@+id/exportServerProfileButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Экспорт профиля" android:enabled="false" style="@style/Widget.HSC.CompactButton" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Передай файл на другое устройство и нажми «Импорт профиля». Сверь отпечаток SSH-ключа с сервером. Пароль вводится отдельно и в профиль не попадает." android:textColor="?attr/hscTextSecondary" android:textSize="13sp" />
<Button android:id="@+id/closeServerSetupButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Готово" style="@style/Widget.HSC.SecondaryButton" />
</LinearLayout></ScrollView>
