<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:orientation="vertical" android:padding="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Файлы сервера" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/remotePathText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="middle" android:maxLines="2" android:text="—" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/filesBackButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Назад" />
        <Button android:id="@+id/filesUpButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Вверх" />
        <Button android:id="@+id/filesRefreshButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Обновить" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/filesUploadButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Загрузить" />
        <Button android:id="@+id/filesMkdirButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Новая папка" />
    </LinearLayout>
    <TextView android:id="@+id/transferStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Очередь пуста" android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/transferProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Скорость передачи" android:textColor="@color/text_secondary" android:textSize="12sp" android:id="@+id/filesSpeedSummary" />
    <com.bitpoint.homeservercontrol.MetricChartView android:id="@+id/filesSpeedChart" android:layout_width="match_parent" android:layout_height="80dp" android:contentDescription="@string/live_speed_chart_description" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/filesCancelTransferButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:enabled="false" android:text="Отменить текущую" />
        <Button android:id="@+id/filesClearQueueButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:enabled="false" android:text="Очистить очередь" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1" android:background="@drawable/panel_bg">
        <ListView android:id="@+id/remoteFileList" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@color/stroke" android:dividerHeight="1dp" android:padding="4dp" />
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="16dp" android:text="Загрузка…" android:textColor="@color/text_secondary" android:textSize="15sp" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Тап: открыть папку / скачать файл. Долгое нажатие: переименовать или удалить. Удаление папки разрешено только если она пустая." android:textColor="@color/text_secondary" android:textSize="12sp" />
</LinearLayout>
