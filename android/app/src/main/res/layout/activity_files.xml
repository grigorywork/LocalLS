<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/hscBackground" android:orientation="vertical" android:padding="8dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Файлы сервера" android:textColor="?attr/hscTextPrimary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/remotePathText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="middle" android:maxLines="2" android:text="—" android:textColor="?attr/hscTextSecondary" android:textIsSelectable="true" android:textSize="13sp" android:contentDescription="Текущая папка. Нажми, чтобы открыть другой путь" android:clickable="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/filesBackButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Назад" />
        <Button android:id="@+id/filesUpButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Вверх" />
        <Button android:id="@+id/filesRefreshButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Обновить" />
    <Button android:id="@+id/filesMinimizeButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:text="Свернуть" style="@style/Widget.HSC.SecondaryButton" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/filesUploadButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Прикрепить" />
        <Button android:id="@+id/filesOpenFolderButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Открыть папку" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="4dp" android:textSize="12sp" />
        <Button android:id="@+id/filesMkdirButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:layout_weight="1" android:text="Новая папка" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/attachmentsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:background="@drawable/panel_bg">
        <TextView android:id="@+id/attachmentsSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Нет вложений" android:textColor="?attr/hscTextPrimary" android:textSize="12sp" android:minHeight="32dp" android:gravity="center_vertical" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/filesClearAttachmentsButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Убрать" style="@style/Widget.HSC.SecondaryButton" />
            <Button android:id="@+id/filesSendAttachmentsButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Отправить" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/transferStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Очередь пуста" android:textColor="?attr/hscAccent" android:textSize="14sp" android:textStyle="bold" />
    <ProgressBar android:id="@+id/transferProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="4dp" android:max="100" android:progress="0" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Скорость передачи" android:textColor="?attr/hscTextSecondary" android:textSize="12sp" android:id="@+id/filesSpeedSummary" />
    <com.bitpoint.homeservercontrol.MetricChartView android:id="@+id/filesSpeedChart" android:layout_width="match_parent" android:layout_height="80dp" android:contentDescription="@string/live_speed_chart_description" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
        <Button android:id="@+id/filesCancelTransferButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:enabled="false" android:text="Отменить текущую" />
        <Button android:id="@+id/filesClearQueueButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="6dp" android:layout_weight="1" android:enabled="false" android:text="Очистить очередь" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp"><Button android:id="@+id/filesSelectButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="3dp" android:text="Выделить" style="@style/Widget.HSC.SecondaryButton" /><Button android:id="@+id/filesDownloadSelectedButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="3dp" android:text="Скачать выбранное" style="@style/Widget.HSC.SecondaryButton" /><Button android:id="@+id/filesClearSelectionButton" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="3dp" android:text="Снять выбор" style="@style/Widget.HSC.SecondaryButton" /></LinearLayout><FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_weight="1" android:background="@drawable/panel_bg">
        <ListView android:id="@+id/remoteFileList" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="?attr/hscStroke" android:dividerHeight="1dp" android:padding="4dp" />
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="16dp" android:text="Загрузка…" android:textColor="?attr/hscTextSecondary" android:textSize="15sp" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="«Выделить»: выбирай файлы в разных папках. Затем «Скачать выбранное» и папка на телефоне. Папки открываются тапом; долгое нажатие — действия." android:textColor="?attr/hscTextSecondary" android:textSize="12sp" />
</LinearLayout>
