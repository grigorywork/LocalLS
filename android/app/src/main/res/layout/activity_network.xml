<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/hscBackground">
    <com.bitpoint.homeservercontrol.SettingsColumn android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/networkBackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/network_search_title" />
        <LinearLayout android:id="@+id/networkAddressCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp" android:layout_marginTop="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/network_address_label" android:labelFor="@id/networkLocalHostInput" android:textColor="?attr/hscTextSecondary" android:textSize="14sp" />
            <EditText android:id="@+id/networkLocalHostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="@string/network_address_hint" android:inputType="text" android:singleLine="true" android:textColor="?attr/hscTextPrimary" android:textColorHint="?attr/hscTextSecondary" android:importantForAutofill="no" />
            <Button android:id="@+id/networkDiscoverButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/network_find" />
            <TextView android:id="@+id/networkResultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/network_discovery_hint" android:textColor="?attr/hscTextSecondary" android:textSize="14sp" android:padding="12dp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/networkSaveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/network_save_address" />
        </LinearLayout>
    </com.bitpoint.homeservercontrol.SettingsColumn>
</ScrollView>
