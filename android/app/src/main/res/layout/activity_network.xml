<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/hscBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сеть" android:textColor="?attr/hscTextPrimary" android:textSize="22sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Локальный Wi‑Fi остаётся основным. Tailscale добавляется вторым маршрутом." android:textColor="?attr/hscTextSecondary" android:textSize="13sp" />

        <RadioGroup android:id="@+id/networkModeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
            <RadioButton android:id="@+id/networkLocalModeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Локально" android:textColor="?attr/hscTextPrimary" />
            <RadioButton android:id="@+id/networkVpnModeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="VPN / Tailscale" android:textColor="?attr/hscTextPrimary" />
        </RadioGroup>

        <EditText android:id="@+id/networkLocalHostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Локальный IP, например 192.168.1.82" android:inputType="text" android:singleLine="true" android:textColor="?attr/hscTextPrimary" android:textColorHint="?attr/hscTextSecondary" />
        <EditText android:id="@+id/networkVpnHostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tailscale 100.x.x.x или MagicDNS" android:inputType="text" android:singleLine="true" android:textColor="?attr/hscTextPrimary" android:textColorHint="?attr/hscTextSecondary" />
        <CheckBox android:id="@+id/networkAutoFallbackCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Автопереход на второй маршрут, если основной недоступен" android:textColor="?attr/hscTextPrimary" />
        <EditText android:id="@+id/networkIperfTargetInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="IP компьютера для iperf3" android:inputType="text" android:singleLine="true" android:textColor="?attr/hscTextPrimary" android:textColorHint="?attr/hscTextSecondary" />

        <Button android:id="@+id/networkTestButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="Проверить SSH-порт" />
        <Button android:id="@+id/networkDiscoverButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="Найти сервер в Wi‑Fi" />
        <TextView android:id="@+id/networkResultText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/panel_bg" android:padding="10dp" android:text="Проверка ещё не запускалась" android:textColor="?attr/hscTextSecondary" android:textSize="14sp" />

        <Button android:id="@+id/tailscaleWizardButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="Мастер Tailscale" />
        <Button android:id="@+id/networkSaveButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="Сохранить сеть" />
        <Button android:id="@+id/networkBackButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Назад" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="20dp" android:text="Не пробрасывай 8022 или 8787 на роутере. Для удалённого доступа используй VPN/Tailscale." android:textColor="?attr/hscTextSecondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
