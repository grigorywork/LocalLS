<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/hscBackground">
    <com.bitpoint.homeservercontrol.SettingsColumn android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/settingsBackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/localls_985b5e0f2ccf" />
        <LinearLayout android:id="@+id/settingsClientOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/settingsMonitorCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/localls_ab71afb97f2e" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/hscTextPrimary" android:paddingBottom="6dp" />
                <CheckBox android:id="@+id/settingsBackgroundMonitorCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/localls_28c524784ed7" android:textSize="16sp" android:textColor="?attr/hscTextPrimary" />
                <TextView android:id="@+id/settingsMonitorDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/monitor_explanation" android:textSize="14sp" android:textColor="?attr/hscTextSecondary" android:paddingBottom="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/settingsShareCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/localls_d515d5d76f4d" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/hscTextPrimary" android:paddingBottom="6dp" />
                <CheckBox android:id="@+id/shareImmediatelyCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/localls_377626743c94" android:textSize="16sp" android:textColor="?attr/hscTextPrimary" />
                <TextView android:id="@+id/shareImmediatelyExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/localls_afb10c96d259" android:textSize="14sp" android:textColor="?attr/hscTextSecondary" android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/settingsServerOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/localls_fea894343e80" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/hscTextPrimary" />
            <Button android:id="@+id/settingsServerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/localls_93cd1ec35325" />
        </LinearLayout>
        <Button android:id="@+id/settingsSaveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:text="@string/localls_d3257f0c9ba3" />
        <Button android:id="@+id/aboutAppButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:text="@string/about_title" />
    </com.bitpoint.homeservercontrol.SettingsColumn>
</ScrollView>
