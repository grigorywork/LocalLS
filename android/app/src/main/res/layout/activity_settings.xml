<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/hscBackground">
    <com.bitpoint.homeservercontrol.SettingsColumn android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <Button android:id="@+id/settingsBackButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Настройки" />
        <LinearLayout android:id="@+id/settingsClientOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:id="@+id/settingsMonitorCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Подключение" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/hscTextPrimary" android:paddingBottom="6dp" />
                <CheckBox android:id="@+id/settingsBackgroundMonitorCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Фоновая проверка" android:textSize="16sp" android:textColor="?attr/hscTextPrimary" />
                <TextView android:id="@+id/settingsMonitorDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/monitor_explanation" android:textSize="14sp" android:textColor="?attr/hscTextSecondary" android:paddingBottom="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/settingsShareCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отправка файлов" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/hscTextPrimary" android:paddingBottom="6dp" />
                <CheckBox android:id="@+id/shareImmediatelyCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Отправлять сразу" android:textSize="16sp" android:textColor="?attr/hscTextPrimary" />
                <TextView android:id="@+id/shareImmediatelyExplanation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Из меню «Поделиться» — на сервер без подтверждения." android:textSize="14sp" android:textColor="?attr/hscTextSecondary" android:paddingBottom="8dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/settingsServerOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:padding="12dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Этот телефон — сервер" android:textSize="18sp" android:textStyle="bold" android:textColor="?attr/hscTextPrimary" />
            <Button android:id="@+id/settingsServerButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Настройки сервера" />
        </LinearLayout>
        <Button android:id="@+id/settingsSaveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:text="Сохранить настройки" />
        <Button android:id="@+id/aboutAppButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="8dp" android:text="@string/about_title" />
    </com.bitpoint.homeservercontrol.SettingsColumn>
</ScrollView>
