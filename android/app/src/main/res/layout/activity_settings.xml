<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Настройки" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" />

        <EditText android:id="@+id/settingsPortInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="SSH-порт" android:inputType="number" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        <EditText android:id="@+id/settingsUserInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Пользователь" android:inputType="text" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        <EditText android:id="@+id/settingsPasswordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Пароль SSH" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:saveEnabled="false" />
        <CheckBox android:id="@+id/settingsSavePasswordCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сохранить пароль в Android Keystore" android:textColor="@color/text_secondary" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Realme Agent" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
        <EditText android:id="@+id/settingsAgentPortInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Порт агента" android:inputType="number" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
        <EditText android:id="@+id/settingsAgentTokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Токен агента" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:saveEnabled="false" />
        <CheckBox android:id="@+id/settingsSaveAgentTokenCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Сохранить токен в Android Keystore" android:textColor="@color/text_secondary" />
        <Button android:id="@+id/agentWizardButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="Мастер установки агента" />

        <CheckBox android:id="@+id/settingsAutoFallbackCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Автопереход Local ↔ Tailscale при недоступности" android:textColor="@color/text_primary" />

        <CheckBox android:id="@+id/settingsBackgroundMonitorCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Фоновый мониторинг сервера (~15 мин)" android:textColor="@color/text_primary" />

        <Button android:id="@+id/settingsSaveButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Сохранить настройки" />
        <Button android:id="@+id/settingsBackButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="Назад" />
    </LinearLayout>
</ScrollView>
