<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home Server Control" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Realme GT Neo 2 • Личный сервер" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/panel_bg" android:orientation="vertical">
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="● НЕ ПРОВЕРЕНО" android:textColor="@color/amber" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/statusDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Нажми «Проверить сервер»" android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/ipValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="IP: —" android:textColor="@color/text_primary" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/portValue" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Порт: —" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_weight="1" android:layout_marginTop="0dp" android:layout_marginStart="2dp" />
                <TextView android:id="@+id/userValue" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Пользователь: —" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_weight="1" android:layout_marginTop="0dp" android:layout_marginStart="2dp" />
            </LinearLayout>
            <RadioGroup android:id="@+id/modeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                <RadioButton android:id="@+id/localModeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Локально" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
                <RadioButton android:id="@+id/vpnModeButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="VPN / Tailscale" android:textColor="@color/text_primary" android:textSize="12sp" android:minHeight="48dp" />
            </RadioGroup>
            <TextView android:id="@+id/fingerprintValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="SSH fingerprint: —" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="13sp" android:visibility="gone" />
            <Button android:id="@+id/trustKeyButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Доверять этому fingerprint" android:visibility="gone" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_bg" android:layout_marginTop="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/latencyValue" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Отклик SSH: —" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_marginTop="0dp" android:layout_weight="1" android:layout_marginStart="2dp" />
                <TextView android:id="@+id/batteryValue" android:layout_width="0dp" android:layout_height="wrap_content" android:text="Батарея: —" android:textColor="@color/text_primary" android:textSize="12sp" android:layout_marginTop="0dp" android:layout_weight="1" android:layout_marginStart="2dp" />
            </LinearLayout>
            <TextView android:id="@+id/diskValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Память: —" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginTop="3dp" />
            <TextView android:id="@+id/uptimeValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Аптайм: —" android:textColor="@color/text_primary" android:textSize="13sp" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_bg" android:layout_marginTop="0dp" android:layout_weight="1" android:layout_marginEnd="3dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Скорость SFTP" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Передач пока нет" android:textColor="@color/text_secondary" android:textSize="11sp" android:id="@+id/dashboardSpeedSummary" android:layout_marginTop="3dp" android:minHeight="30dp" android:maxLines="2" />
                <com.bitpoint.homeservercontrol.MetricChartView android:id="@+id/dashboardSpeedChart" android:layout_width="match_parent" android:layout_height="94dp" android:contentDescription="@string/live_speed_chart_description" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:orientation="vertical" android:background="@drawable/panel_bg">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Отклик SSH" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/dashboardLatencySummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="30dp" android:layout_marginTop="3dp" android:maxLines="2" android:text="Нет замеров" android:textColor="@color/text_secondary" android:textSize="11sp" />
                <com.bitpoint.homeservercontrol.MetricChartView android:id="@+id/dashboardLatencyChart" android:layout_width="match_parent" android:layout_height="94dp" android:contentDescription="График отклика SSH в миллисекундах" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/panel_bg" android:layout_marginTop="6dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Управление" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <Button android:id="@+id/checkButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Проверить SSH" android:textSize="14sp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <Button android:id="@+id/filesButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Файлы" android:textSize="14sp" android:layout_weight="1" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/networkButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Сеть" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                <Button android:id="@+id/settingsButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_weight="1" android:text="Настройки" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                <Button android:id="@+id/historyButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="3dp" android:layout_weight="1" android:text="Графики" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <Button android:id="@+id/diagnosticsButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Диагностика" android:layout_weight="1" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <Button android:id="@+id/advancedToggleButton" android:layout_width="0dp" android:layout_height="48dp" android:text="Подключение и инструменты ▾" android:layout_marginTop="0dp" android:layout_weight="2" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
        </LinearLayout>
        <EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Пароль SSH для подключения" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:saveEnabled="false" android:textSize="14sp" />
        <LinearLayout android:id="@+id/advancedPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Подключение" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <EditText android:id="@+id/localHostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Локальный IP, например 192.168.1.82" android:inputType="text" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <EditText android:id="@+id/vpnHostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="VPN IP / имя Tailscale, например 100.x.x.x" android:inputType="text" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <EditText android:id="@+id/portInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="SSH-порт" android:inputType="number" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <EditText android:id="@+id/userInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Пользователь" android:inputType="text" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <CheckBox android:id="@+id/savePasswordCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сохранить пароль в Android Keystore" android:textColor="@color/text_secondary" />
                <Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Сохранить настройки" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Состояние сервера" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/sshdValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="sshd: —" android:textColor="@color/text_primary" android:textSize="16sp" />
                <TextView android:id="@+id/temperatureValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Температура: —" android:textColor="@color/text_primary" android:textSize="16sp" />
                <TextView android:id="@+id/chargingValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Питание: —" android:textColor="@color/text_primary" android:textSize="16sp" />
                <TextView android:id="@+id/iperfValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="iperf3: —" android:textColor="@color/text_primary" android:textSize="16sp" />
                <Button android:id="@+id/forgetKeyButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:text="Забыть сохранённый fingerprint" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
            <Button android:id="@+id/copyButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Скопировать данные SFTP" android:textSize="17sp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            <Button android:id="@+id/solidButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Открыть Solid Explorer" android:textSize="17sp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            <Button android:id="@+id/exportButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Экспорт диагностики" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            <CheckBox android:id="@+id/autoRefreshCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Автопроверка каждые 15 секунд" android:textColor="@color/text_secondary" />
            <CheckBox android:id="@+id/backgroundMonitorCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Фоновый мониторинг (примерно каждые 15 минут)" android:textColor="@color/text_secondary" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Быстрые команды" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/quickSshdButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Проверить sshd" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                    <Button android:id="@+id/quickIpButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Показать IP" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/quickDiskButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Проверить память" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                    <Button android:id="@+id/quickUptimeButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Показать uptime" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                </LinearLayout>
                <TextView android:id="@+id/commandHelpText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Нажми команду — приложение покажет результат и объяснит, что она делает." android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Тест скорости iperf3" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="На ПК сначала запусти: iperf3 -s. Здесь укажи IP ПК." android:textColor="@color/text_secondary" android:textSize="13sp" />
                <EditText android:id="@+id/iperfTargetInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="IP компьютера с iperf3 -s" android:inputType="text" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <Button android:id="@+id/runIperfButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Запустить тест Realme → ПК" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                <TextView android:id="@+id/iperfOutputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Результат: —" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Независимый агент Realme (опционально)" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Нужен только для Start/Stop/Restart sshd, когда сам SSH недоступен. Агент устанавливается отдельно из папки realme-agent. Не открывай его порт в интернет." android:textColor="@color/text_secondary" android:textSize="13sp" />
                <EditText android:id="@+id/agentPortInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Порт агента" android:inputType="number" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />
                <EditText android:id="@+id/agentTokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Токен агента" android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:saveEnabled="false" />
                <CheckBox android:id="@+id/saveAgentTokenCheck" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Сохранить токен в Android Keystore" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/agentOutputText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Агент: не проверен" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/agentStatusButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Проверить агент" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                    <Button android:id="@+id/agentStartButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Запустить SSH" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                    <Button android:id="@+id/agentRestartButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Перезапустить SSH" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                    <Button android:id="@+id/agentStopButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="0dp" android:text="Остановить SSH" android:layout_weight="1" android:layout_marginStart="3dp" style="@style/Widget.HSC.SecondaryButton" android:layout_marginEnd="3dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="История свободного места" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/historyValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="История пока пустая" android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="13sp" />
                <Button android:id="@+id/clearHistoryButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Очистить историю" style="@style/Widget.HSC.SecondaryButton" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/panel_bg" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Журнал" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="80dp" android:text="Готов к работе." android:textColor="@color/text_secondary" android:textIsSelectable="true" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="12dp" android:text="v0.8 • Realme GT Neo 2" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
